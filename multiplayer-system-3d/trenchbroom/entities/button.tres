"targetname": "",
"trigger_signal_delay": 0.0
})
class_property_descriptions = Dictionary[String, Variant]({
"axis": "Direction it sinks, in TrenchBroom's axes (0 0 -1 is down)",
"depth": "How far it sinks, in map units",
"release_delay": "Seconds to stay pressed after the last player steps off",
"speed": "Sink speed - 8 is an eighth of a second",
"target": "targetname of the entity to fire",
"targetname": "Name other entities use to target this one",
"trigger_signal_delay": "Seconds between being stood on and firing its target"
