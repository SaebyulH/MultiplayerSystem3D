[resource]
script = ExtResource("2_mpc")
target_map_editor = 1
models_sub_folder = "trenchbroom/models"
scale_expression = "{{ scale == undefined -> 32, scale * 32 }}"
rotation_offset = Vector3(0, 180, 0)
scene_file = ExtResource("1_scene")
classname = "PayloadPathPoint"
description = "One waypoint of a payload route - draw them front to back and they connect in order"
class_properties = Dictionary[String, Variant]({
"rollback_zone": false,
"rollforward_zone": false,
"target": "",
"targetname": ""
})
class_property_descriptions = Dictionary[String, Variant]({
"rollback_zone": "From here to the next point, the cart rolls back the moment nobody is on it, instead of waiting out the cart's return delay",
"rollforward_zone": "From here to the next point, the cart drives itself forward with nobody on it",
"target": "OPTIONAL. Route points connect in the order you place them. Set this only to override that - it switches the whole map to an explicit chain, so then every point needs naming",
"targetname": "OPTIONAL. Only used when some point sets 'target'"
})
auto_apply_to_matching_node_properties = true
