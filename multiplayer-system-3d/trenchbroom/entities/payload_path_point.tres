"color": Color(1, 0.45, 0.1, 1),
"model": "{\"path\": \"trenchbroom/models/PayloadPathPoint.glb\", \"scale\": {{ scale == undefined -> 32, scale * 32 }} }",
"size": AABB(-16, -16, 0, 16, 16, 16)
})
